import cv2
import numpy as np
import pandas as pd
import streamlit as st
from datetime import datetime


class PlantAnalyzer:
    """컴퓨터 비전을 활용한 식물 생육 데이터 추출 클래스"""

    def __init__(self, pixel_to_cm_ratio=0.05):
        self.pixel_to_cm_ratio = pixel_to_cm_ratio

        self.lower_green = np.array([30, 35, 35])
        self.upper_green = np.array([85, 255, 255])

    def set_hsv_bounds(self, lower, upper):
        self.lower_green = np.array(lower)
        self.upper_green = np.array(upper)

    def set_pixel_ratio(self, ratio):
        self.pixel_to_cm_ratio = ratio

    def process_image(self, img):
        """
        업로드된 이미지를 분석하여
        생육 지표, 분석 이미지, 마스크, 원본 이미지를 반환
        """

        if img is None:
            raise ValueError("이미지를 읽을 수 없습니다.")

        # 1. 이미지 전처리
        blurred = cv2.GaussianBlur(img, (5, 5), 0)

        # 2. HSV 색상 공간 변환
        hsv = cv2.cvtColor(blurred, cv2.COLOR_BGR2HSV)

        # 3. 초록색 영역 추출
        mask = cv2.inRange(
            hsv,
            self.lower_green,
            self.upper_green
        )

        # 4. 노이즈 제거 및 빈 공간 보정
        kernel = cv2.getStructuringElement(
            cv2.MORPH_RECT,
            (5, 5)
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_CLOSE,
            kernel
        )

        # 5. 윤곽선 추출
        contours, _ = cv2.findContours(
            mask.copy(),
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        # 분석 결과 이미지
        result_img = img.copy()

        metrics = {
            "height_px": 0,
            "width_px": 0,
            "height_cm": 0.0,
            "width_cm": 0.0,
            "projected_area_px": 0
        }

        if contours:
            # 가장 큰 윤곽선을 대표 식물 영역으로 선택
            main_contour = max(
                contours,
                key=cv2.contourArea
            )

            x, y, w, h = cv2.boundingRect(main_contour)

            # 생육 지표 계산
            metrics = {
                "height_px": h,
                "width_px": w,
                "height_cm": round(
                    h * self.pixel_to_cm_ratio, 2
                ),
                "width_cm": round(
                    w * self.pixel_to_cm_ratio, 2
                ),
                "projected_area_px": int(
                    cv2.countNonZero(mask)
                )
            }

            # 검출 영역 표시
            cv2.rectangle(
                result_img,
                (x, y),
                (x + w, y + h),
                (0, 255, 0),
                2
            )

            cv2.drawContours(
                result_img,
                [main_contour],
                -1,
                (0, 0,255),
                2
            )

            # 측정값 표시
            label = (
                f"H: {metrics['height_cm']:.1f} cm, "
                f"W: {metrics['width_cm']:.1f} cm"
            )

            cv2.putText(
                result_img,
                label,
                (x, max(y - 10, 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )

        return metrics, result_img, mask, img


class GardeningAssistant:
    """생육 데이터와 환경 데이터를 활용하는 관리 추천 클래스"""

    @staticmethod
    def calculate_growth_rate(
        current_val,
        previous_val,
        days_diff
    ):
        if days_diff <= 0:
            return None

        return round(
            (current_val - previous_val) / days_diff,
            3
        )

    @staticmethod
    def evaluate_plant_status(
        growth_rate,
        soil_moisture=None,
        illuminance=None,
        temp=None,
        humidity=None
    ):
        recommendations = []

        if growth_rate is None:
            recommendations.append(
                "생장률을 계산하려면 이전 측정 데이터가 필요합니다."
            )
        elif growth_rate < 0:
            recommendations.append(
                "측정된 생육 지표가 감소했습니다. "
                "원본 사진과 식물 영역 추출 결과를 확인하세요."
            )
        elif growth_rate == 0:
            recommendations.append(
                "생육 지표에 변화가 없습니다. "
                "추가 관찰을 통해 추세를 확인하세요."
            )
        else:
            recommendations.append(
                "측정된 생육 지표가 증가했습니다. "
                "현재 관리 상태를 계속 관찰하세요."
            )

        if temp is None or humidity is None:
            recommendations.append(
                "온도와 습도 데이터가 없어 "
                "환경 분석을 완료할 수 없습니다."
            )

        return " | ".join(recommendations)


