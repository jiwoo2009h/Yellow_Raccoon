# Streamlit 웹 화면
# =========================================================

st.set_page_config(
    page_title="식물 생육 분석 시스템",
    page_icon="🌱",
    layout="wide"
)

st.title("🌱 식물 생육 분석 및 관리 추천 시스템")

st.write(
    "식물 사진을 업로드하면 OpenCV를 이용해 "
    "식물 영역을 추출하고 생육 지표를 계산합니다."
)

st.divider()

# 1. 분석 설정
st.subheader("1. 분석 설정")

col1, col2 = st.columns(2)

with col1:
    plant_id = st.text_input(
        "식물 ID",
        value="basil"
    )

with col2:
    pixel_ratio = st.number_input(
        "픽셀당 실제 길이 (cm/pixel)",
        min_value=0.0001,
        max_value=10.0,
        value=0.05,
        step=0.01,
        format="%.4f",
        help="자 등으로 실제 길이를 보정한 값을 입력하세요."
    )

# 2. 이미지 업로드
st.subheader("2. 식물 사진 업로드")

uploaded_file = st.file_uploader(
    "분석할 식물 사진을 선택하세요.",
    type=["jpg", "jpeg", "png"],
    help="JPG, JPEG, PNG 파일을 업로드할 수 있습니다."
)

if uploaded_file is not None:

    # 업로드한 이미지의 바이트 데이터를 OpenCV 형식으로 변환
    file_bytes = np.frombuffer(
        uploaded_file.getvalue(),
        dtype=np.uint8
    )

    image = cv2.imdecode(
        file_bytes,
        cv2.IMREAD_COLOR
    )

    if image is None:
        st.error(
            "이미지를 불러오지 못했습니다. "
            "다른 이미지 파일을 선택해 주세요."
        )

    else:
        # 분석 버튼을 눌렀을 때 실행
        if st.button(
            "식물 이미지 분석하기",
            type="primary"
        ):

            analyzer = PlantAnalyzer(
                pixel_to_cm_ratio=pixel_ratio
            )

            try:
                with st.spinner("이미지를 분석하고 있습니다..."):

                    metrics, processed_img, mask, original_img = (
                        analyzer.process_image(image)
                    )

                # 분석 결과 저장
                st.session_state["metrics"] = metrics
                st.session_state["processed_img"] = processed_img
                st.session_state["mask"] = mask
                st.session_state["original_img"] = original_img
                st.session_state["plant_id"] = plant_id
                st.session_state["filename"] = uploaded_file.name

            except Exception as e:
                st.error(f"이미지 분석 중 오류가 발생했습니다: {e}")

        # 분석이 완료된 경우 결과 표시
        if "metrics" in st.session_state:

            metrics = st.session_state["metrics"]

            st.divider()
            st.subheader("3. 이미지 분석 결과")

            col1, col2, col3 = st.columns(3)

            with col1:
                st.image(
                    cv2.cvtColor(
                        st.session_state["original_img"],
                        cv2.COLOR_BGR2RGB
                    ),
                    caption="원본 이미지",
                    use_container_width=True
                )

            with col2:
                st.image(
                    st.session_state["mask"],
                    caption="식물 영역 마스크",
                    clamp=True,
                    use_container_width=True
                )

            with col3:
                st.image(
                    cv2.cvtColor(
                        st.session_state["processed_img"],
                        cv2.COLOR_BGR2RGB
                    ),
                    caption="윤곽선 검출 결과",
                    use_container_width=True
                )

            st.divider()
            st.subheader("4. 추출된 생육 지표")

            c1, c2, c3 = st.columns(3)

            c1.metric(
                "식물 높이",
                f"{metrics['height_cm']} cm"
            )

            c2.metric(
                "식물 너비",
                f"{metrics['width_cm']} cm"
            )

            c3.metric(
                "투영 면적",
                f"{metrics['projected_area_px']:,} px²"
            )

            with st.expander("픽셀 단위 측정값 확인"):
                st.write(
                    f"높이: {metrics['height_px']} px"
                )
                st.write(
                    f"너비: {metrics['width_px']} px"
                )

            st.caption(
                "주의: 실제 길이 환산값은 촬영 환경과 "
                "픽셀 보정값에 따라 달라집니다. "
                "투영 면적은 사진에서 추출한 픽셀 수입니다."
            )

            # 5. 측정 결과를 CSV로 저장할 수 있도록 구성
            st.divider()
            st.subheader("5. 분석 결과 저장")

            if st.button("분석 결과 저장용 데이터 생성"):

                result_df = pd.DataFrame([{
                    "날짜": datetime.now().strftime("%Y-%m-%d"),
                    "식물ID": st.session_state["plant_id"],
                    "파일명": st.session_state["filename"],
                    "높이(px)": metrics["height_px"],
                    "너비(px)": metrics["width_px"],
                    "높이(cm)": metrics["height_cm"],
                    "너비(cm)": metrics["width_cm"],
                    "투영면적(px²)": metrics["projected_area_px"]
                }])

                st.session_state["result_df"] = result_df

            if "result_df" in st.session_state:

                st.dataframe(
                    st.session_state["result_df"],
                    use_container_width=True
                )

                csv_data = st.session_state["result_df"].to_csv(
                    index=False
                ).encode("utf-8-sig")

                st.download_button(
                    label="CSV 파일 다운로드",
                    data=csv_data,
                    file_name="plant_growth_data.csv",
                    mime="text/csv"
                )

else:
    st.info(
        "위의 파일 선택 버튼을 눌러 식물 사진을 업로드하세요."
    )
